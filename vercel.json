{
  "crons": [
    {
      "path": "/api/daily-report?period=daily",
      "schedule": "0 21 * * *"
    },
    {
      "path": "/api/daily-report?period=weekly",
      "schedule": "0 21 * * 0"
    },
    {
      "path": "/api/daily-report?period=monthly",
      "schedule": "0 21 1 * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
